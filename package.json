{
  "name": "scankar",
  "version": "1.0.0",
  "private": true,
  "description": "Offline ML/CV scanner for handwritten machine-reading sheets",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease",
    "build:android:bundle": "cd android && ./gradlew bundleRelease",
    "build:ios:release": "cd ios && xcodebuild -workspace SCANkarNativeShell.xcworkspace -scheme SCANkarNativeShell -configuration Release"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "date-fns": "^3.6.0",
    "docx": "^8.5.0",
    "exceljs": "^4.4.0",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.2",
    "lodash": "^4.17.21",
    "papaparse": "^5.4.1",
    "react": "18.2.0",
    "react-native": "0.72.6",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^2.13.4",
    "react-native-image-crop-picker": "^0.40.3",
    "react-native-reanimated": "^3.3.0",
    "react-native-safe-area-context": "^4.7.4",
    "react-native-screens": "^3.27.0",
    "react-native-svg": "^13.14.1",
    "react-native-vision-camera": "^3.9.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/metro-config": "^0.80.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^2.8.8",
    "react-test-renderer": "18.2.0"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
